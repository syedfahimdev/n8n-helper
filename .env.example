# ============================================================
# n8n-helper — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Authentication ---
# Bearer token n8n (or any other client) sends in the Authorization header.
# Generate a strong random token: `python -c 'import secrets; print(secrets.token_urlsafe(32))'`
N8N_HELPER_TOKEN=replace-me-with-a-long-random-string

# Optional second token (e.g. for a different client / read-only role).
# Leave blank to disable.
N8N_HELPER_TOKEN_RO=

# --- Optional integrations ---
# Used by the run_skill tool when a skill body is markdown-instruction style.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Path to the user's master resume (used by the job-scorer skill).
RESUME_PATH=/root/n8n-helper/data/resume.md

# Comma-separated list of allowed origins for CORS (if you ever expose a UI).
ALLOWED_ORIGINS=*

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_TAILOR_MODEL=claude-haiku-4-5-20251001

# --- PDF rendering (Gotenberg sidecar to n8n) ---
GOTENBERG_URL=http://gotenberg:3000
